{
  "version": 2,
  "builds": [
    {
      "src": "config.ru",
      "use": "@vercel/ruby",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "config.ru" }
  ],
  "env": {
    "RAILS_ENV": "production",
    "RAILS_LOG_TO_STDOUT": "true"
  }
}
