# Copy to .env.development.local and fill in values

# Database — Vercel Postgres (Neon) injects this automatically in production
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/knowledge_platform_development

# JWT secret — change this in production!
JWT_SECRET=dev-secret-change-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Rails
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
